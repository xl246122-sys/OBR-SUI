[Unit]
Description=SUI-Quant F-02 System Guardian & S-01 Host Security Supervisor
After=network.target sui-quant-r01.service
Requires=sui-quant-r01.service
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=sui-quant-circuit-breaker@%n.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/sui-quant
Environment="PYTHONPATH=/opt/sui-quant/src"
Environment="SUI_QUANT_MODE=PAPER"
ExecStart=/usr/bin/python3 -m sui_quant.daemon.soak_runner --mode service --service-name guardian --db-path /var/lib/sui-quant/state.db
Restart=on-failure
RestartSec=5s
TimeoutStopSec=15s
Nice=-5
CPUWeight=300
MemoryHigh=80M
MemoryMax=100M
OOMScoreAdjust=-400
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
